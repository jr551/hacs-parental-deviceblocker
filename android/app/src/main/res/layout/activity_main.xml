<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/block_background">

    <ScrollView
        android:id="@+id/setupScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Parental Device Blocker"
                android:textColor="@color/white"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Enter this child's name and your Home Assistant address."
                android:textColor="@color/white"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:labelFor="@+id/childName"
                android:text="Child's name"
                android:textColor="@color/white"
                android:textSize="22sp" />

            <EditText
                android:id="@+id/childName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Child's name"
                android:inputType="textCapWords"
                android:textColor="@color/white"
                android:textColorHint="@color/muted"
                android:textSize="20sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:labelFor="@+id/homeAssistantUrl"
                android:text="Home Assistant address"
                android:textColor="@color/white"
                android:textSize="22sp" />

            <EditText
                android:id="@+id/homeAssistantUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Home Assistant address"
                android:inputType="textUri"
                android:textColor="@color/white"
                android:textColorHint="@color/muted"
                android:textSize="20sp" />

            <Button
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="24dp"
                android:text="Set up this phone" />

            <Button
                android:id="@+id/moreButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@android:color/transparent"
                android:text="More"
                android:textAllCaps="false"
                android:textColor="@color/muted"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/moreSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

            <Button
                android:id="@+id/accessibilityButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Enable blocker accessibility service" />

            <Button
                android:id="@+id/batteryButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Allow unrestricted battery" />

            <Button
                android:id="@+id/uninstallGuardButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Activate uninstall protection" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Wake alarm"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/wakeStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wake alarm is set in Home Assistant."
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <Button
                android:id="@+id/wakePermissionButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:text="Allow alarms"
                android:visibility="gone" />

            <Button
                android:id="@+id/changePinButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="Change parent PIN" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Enable Accessibility, then tap Allow unrestricted battery. On Samsung Galaxy S20, S20+ (SM-G986B), and S22 also set Battery to Unrestricted and remove the app from Sleeping apps, Deep sleeping apps, and Put unused apps to sleep. This is friction, not Device Owner: uninstall and Accessibility off still bypass enforcement, and a network failure fails open."
                android:textColor="@color/muted"
                android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/blockedPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:id="@+id/blockTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="This phone is paused"
            android:textColor="@color/white"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/blockMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="A parent has paused this device."
            android:textColor="@color/muted"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/blockCountdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Blocking shortly."
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/familyStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="16sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/blockLastApp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/requestUnblockButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:text="Request unblock"
            android:visibility="gone" />

        <TextView
            android:id="@+id/blockRequestStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/muted"
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/extensionButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="24dp"
            android:text="Give me another 5 minutes" />

        <Button
            android:id="@+id/pointsHourButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="12dp"
            android:text="Buy 1 hour for 200 points" />

        <Button
            android:id="@+id/parentOverrideButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="Parent: give 1 more hour" />

        <GridLayout
            android:id="@+id/allowedApps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:columnCount="4"
            android:useDefaultMargins="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="The apps above stay available. Emergency calling also stays available from Android's lock screen."
            android:textColor="@color/muted"
            android:textSize="14sp" />
    </LinearLayout>
    </ScrollView>
</FrameLayout>
