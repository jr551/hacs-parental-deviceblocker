<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- A parent's pause is a cool navy; the chore challenge is a saturated
         violet, so the two never look like the same screen. -->
    <color name="block_background">#0C2238</color>
    <color name="panel_background">#1F2937</color>
    <color name="primary">#2563EB</color>
    <color name="whatsapp">#128C7E</color>
    <color name="maps">#4285F4</color>
    <color name="white">#FFFFFF</color>
    <color name="muted">#CBD5E1</color>
    <!-- The chore challenge has its own tone, so it never reads as an ordinary pause. -->
    <color name="challenge_background">#3B0764</color>
    <color name="challenge_highlight">#A78BFA</color>
    <!-- A parent's rejection is the one thing the child must not miss. -->
    <color name="challenge_denied_background">#7F1D1D</color>
    <color name="challenge_denied_heading">#FCA5A5</color>
    <!-- The answer field, so the whole box can glow with the step pulse. -->
    <color name="challenge_field">#312E81</color>
    <color name="challenge_field_stroke">#4338CA</color>
    <color name="challenge_field_highlight">#4C1D95</color>
</resources>
